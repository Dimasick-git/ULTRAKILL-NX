+/* Call on the render thread after finishing outstanding GPU work.
+ * Only wholly unused slabs are evicted; live resources retain their backing. */
+uint64_t
+nouveau_mm_trim(struct nouveau_mman *cache)
+{
+   uint64_t released = 0;
+   struct mm_slab *slab, *next;
+   int i;
+   if (!cache) return 0;
+   for (i = 0; i < MM_NUM_BUCKETS; ++i) {
+      LIST_FOR_EACH_ENTRY_SAFE(slab, next, &cache->bucket[i].free, head) {
+         assert(slab->free == slab->count);
+         released += slab->bo->size;
+         cache->allocated -= slab->bo->size;
+         list_del(&slab->head);
+         nouveau_bo_ref(NULL, &slab->bo);
+         FREE(slab);
+      }
+   }
+   return released;
+}
+
 void
 nouveau_mm_destroy(struct nouveau_mman *cache)
 {
