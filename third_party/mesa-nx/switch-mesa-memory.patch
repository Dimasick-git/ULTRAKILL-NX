+
+/* One GLES device in the port. Invoked from its current render thread only. */
+PUBLIC uint64_t nouveau_nx_trim_memory(void)
+{
+    struct nouveau_screen *screen = nx_trim_screen;
+    if (!screen) return 0;
+    nouveau_fence_update(screen, true);
+    uint64_t released = nouveau_mm_trim(screen->mm_GART);
+    if (screen->mm_VRAM != screen->mm_GART)
+        released += nouveau_mm_trim(screen->mm_VRAM);
+    return released;
+}
