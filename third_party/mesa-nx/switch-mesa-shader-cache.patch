+#define NVC0_CODE_CACHE_VERSION 1
+
+/* Since the last nvc0_code_cache_take_stats(): translations served from the
+ * cache, run through codegen and stored, and not cacheable; time of the first
+ * two. The loader reads them for its log. */
+static struct {
+   uint32_t hits, misses, uncached;
+   uint64_t hit_ns, miss_ns;
+} nvc0_code_cache_stats;
+
+void
+nvc0_code_cache_take_stats(uint32_t counts[3], uint64_t ns[2])
+{
+   counts[0] = p_atomic_xchg(&nvc0_code_cache_stats.hits, 0);
+   counts[1] = p_atomic_xchg(&nvc0_code_cache_stats.misses, 0);
+   counts[2] = p_atomic_xchg(&nvc0_code_cache_stats.uncached, 0);
+   ns[0] = p_atomic_xchg(&nvc0_code_cache_stats.hit_ns, 0);
+   ns[1] = p_atomic_xchg(&nvc0_code_cache_stats.miss_ns, 0);
+}
+
+static bool
+nvc0_code_cache_key(struct disk_cache *cache, const struct nvc0_program *prog,
+                    uint16_t chipset, cache_key key)
+{
+   if (!disk_cache_is_persistent(cache) ||
+       prog->type == PIPE_SHADER_COMPUTE ||
+       prog->pipe.type != PIPE_SHADER_IR_TGSI ||
+       prog->pipe.stream_output.num_outputs)
+      return false;
+
+   struct blob blob;
+   blob_init(&blob);
+   blob_write_uint32(&blob, NVC0_CODE_CACHE_VERSION);
+   blob_write_uint32(&blob, prog->type);
+   blob_write_uint32(&blob, chipset);
+   blob_write_uint32(&blob, prog->vp.num_ucps); /* io.genUserClip */
+   blob_write_bytes(&blob, prog->pipe.tokens,
+                    tgsi_num_tokens(prog->pipe.tokens) *
+                    sizeof(struct tgsi_token));
+   const bool ok = !blob.out_of_memory;
+   if (ok)
+      disk_cache_compute_key(cache, blob.data, blob.size, key);
+   blob_finish(&blob);
+   return ok;
+}
+
+/* Everything nvc0_program_translate() sets on a non-compute program. */
+static void
+nvc0_code_cache_store(struct disk_cache *cache, const cache_key key,
+                      const struct nvc0_program *prog)
+{
+   const uint32_t relocs_size =
+      prog->relocs ? nv50_ir_relocs_size(prog->relocs) : 0;
+   const uint32_t fixup_words =
+      prog->fixups ? nv50_ir_fixups_serialized_words(prog->fixups) : 0;
+   uint32_t *fixups = NULL;
+   if (fixup_words) {
+      fixups = MALLOC(fixup_words * 4);
+      if (!fixups || !nv50_ir_fixups_serialize(prog->fixups, fixups)) {
+         FREE(fixups);
+         return;
+      }
+   }
+
+   struct blob blob;
+   blob_init(&blob);
+   blob_write_uint32(&blob, NVC0_CODE_CACHE_VERSION);
+   blob_write_uint32(&blob, prog->code_size);
+   blob_write_bytes(&blob, prog->code, prog->code_size);
+   blob_write_uint32(&blob, relocs_size);
+   blob_write_bytes(&blob, prog->relocs, relocs_size);
+   blob_write_uint32(&blob, fixup_words);
+   blob_write_bytes(&blob, fixups, fixup_words * 4);
+   blob_write_uint8(&blob, prog->need_tls);
+   blob_write_uint8(&blob, prog->num_gprs);
+   blob_write_uint8(&blob, prog->num_barriers);
+   blob_write_uint32(&blob, prog->parm_size);
+   blob_write_bytes(&blob, prog->hdr, sizeof(prog->hdr));
+   blob_write_bytes(&blob, prog->flags, sizeof(prog->flags));
+   blob_write_bytes(&blob, &prog->vp, sizeof(prog->vp));
+   blob_write_bytes(&blob, &prog->fp, sizeof(prog->fp));
+   blob_write_bytes(&blob, &prog->tp, sizeof(prog->tp));
+   FREE(fixups);
+
+   if (!blob.out_of_memory) {
