+uint32_t
+nv50_ir_relocs_size(const void *relocData)
+{
+   const nv50_ir::RelocInfo *info =
+      reinterpret_cast<const nv50_ir::RelocInfo *>(relocData);
+   return sizeof(*info) + info->count * sizeof(info->entry[0]);
+}
+
+uint32_t
+nv50_ir_fixups_serialized_words(const void *fixupData)
+{
+   const nv50_ir::FixupInfo *info =
+      reinterpret_cast<const nv50_ir::FixupInfo *>(fixupData);
+   return 1 + 2 * info->count;
+}
+
+bool
+nv50_ir_fixups_serialize(const void *fixupData, uint32_t *out)
+{
+   const nv50_ir::FixupInfo *info =
+      reinterpret_cast<const nv50_ir::FixupInfo *>(fixupData);
+
+   out[0] = info->count;
+   for (unsigned i = 0; i < info->count; ++i) {
+      const nv50_ir::FixupEntry &e = info->entry[i];
+      unsigned id;
+      for (id = 0; id < ARRAY_SIZE(nv50_ir::gm107FixupApply); ++id)
+         if (e.apply == nv50_ir::gm107FixupApply[id])
+            break;
+      if (id == ARRAY_SIZE(nv50_ir::gm107FixupApply))
+         return false;
+      out[1 + 2 * i] = id;
+      out[2 + 2 * i] = e.val;
+   }
+   return true;
+}
+
+void *
+nv50_ir_fixups_deserialize(const uint32_t *in, uint32_t words)
+{
+   if (words < 1 || words != 1 + 2 * in[0])
+      return NULL;
+   const uint32_t count = in[0];
+   nv50_ir::FixupInfo *info = reinterpret_cast<nv50_ir::FixupInfo *>(
+      MALLOC(sizeof(nv50_ir::FixupInfo) + count * sizeof(nv50_ir::FixupEntry)));
+   if (!info)
+      return NULL;
+   info->count = count;
+   for (unsigned i = 0; i < count; ++i) {
+      const uint32_t id = in[1 + 2 * i];
+      if (id >= ARRAY_SIZE(nv50_ir::gm107FixupApply)) {
+         FREE(info);
+         return NULL;
+      }
+      info->entry[i].apply = nv50_ir::gm107FixupApply[id];
+      info->entry[i].val = in[2 + 2 * i];
+   }
+   return info;
+}
