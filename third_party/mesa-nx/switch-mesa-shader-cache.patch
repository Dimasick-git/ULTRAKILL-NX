+
+static bool
+nvc0_code_cache_load(struct disk_cache *cache, const cache_key key,
+                     struct nvc0_program *prog)
+{
+   if (!disk_cache_has_key(cache, key))
+      return false;
+   size_t size = 0;
+   void *data = disk_cache_get(cache, key, &size);
+   if (!data)
+      return false;
+
+   struct nvc0_program p = *prog;
+   struct blob_reader r;
+   blob_reader_init(&r, data, size);
+   bool ok = blob_read_uint32(&r) == NVC0_CODE_CACHE_VERSION;
+
+   p.code_size = blob_read_uint32(&r);
+   const void *code = blob_read_bytes(&r, p.code_size);
+   const uint32_t relocs_size = blob_read_uint32(&r);
+   const void *relocs = blob_read_bytes(&r, relocs_size);
+   const uint32_t fixup_words = blob_read_uint32(&r);
+   const void *fixups = blob_read_bytes(&r, fixup_words * 4);
+   p.need_tls = blob_read_uint8(&r);
+   p.num_gprs = blob_read_uint8(&r);
+   p.num_barriers = blob_read_uint8(&r);
+   p.parm_size = blob_read_uint32(&r);
+   blob_copy_bytes(&r, p.hdr, sizeof(p.hdr));
+   blob_copy_bytes(&r, p.flags, sizeof(p.flags));
+   blob_copy_bytes(&r, &p.vp, sizeof(p.vp));
+   blob_copy_bytes(&r, &p.fp, sizeof(p.fp));
+   blob_copy_bytes(&r, &p.tp, sizeof(p.tp));
