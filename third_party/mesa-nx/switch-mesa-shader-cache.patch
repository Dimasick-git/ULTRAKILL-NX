+   }
+   if (ok && relocs_size) {
+      p.relocs = MALLOC(relocs_size);
+      ok = p.relocs != NULL;
+      if (ok) {
+         memcpy(p.relocs, relocs, relocs_size);
+         ok = relocs_size == nv50_ir_relocs_size(p.relocs);
+      }
+   }
+   if (ok && fixup_words) {
